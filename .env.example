JARVIS_ENVIRONMENT=development
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765
JARVIS_LOG_LEVEL=INFO
JARVIS_DATA_DIR=data
JARVIS_LOG_DIR=logs
JARVIS_REQUIRE_CONFIRMATION=true
JARVIS_ALLOW_NETWORK=false
JARVIS_AUDIO_SAMPLE_RATE=16000
JARVIS_AUDIO_CHANNELS=4
JARVIS_AUDIO_DEVICE_INDEX=
JARVIS_AUDIO_DEVICE_NAME=
JARVIS_AUDIO_CHANNEL_INDEX=1
JARVIS_MAX_RECORDING_SECONDS=30
JARVIS_WHISPER_MODEL=models/whisper
JARVIS_WHISPER_DEVICE=cpu
JARVIS_WHISPER_COMPUTE_TYPE=int8
JARVIS_WHISPER_LANGUAGE=en
JARVIS_ALLOW_MODEL_DOWNLOAD=false
JARVIS_WAKE_MODEL_DIR=models/wakeword
JARVIS_WAKE_THRESHOLD=0.2
JARVIS_WAKE_COOLDOWN_SECONDS=2
JARVIS_OLLAMA_URL=http://127.0.0.1:11434
JARVIS_OLLAMA_MODEL=qwen3:1.7b
JARVIS_OLLAMA_VISION_MODEL=qwen3.5:0.8b
JARVIS_OLLAMA_TIMEOUT_SECONDS=90
JARVIS_ASSISTANT_HISTORY_MESSAGES=12
JARVIS_PIPER_MODEL=models/piper/en_US-lessac-medium.onnx
JARVIS_FACE_MODEL_ROOT=models/insightface
JARVIS_FACE_MODEL_NAME=buffalo_l
JARVIS_FACE_SIMILARITY_THRESHOLD=0.45
JARVIS_FACE_CAMERA_INDEX=0
JARVIS_FACE_SESSION_MINUTES=5
JARVIS_YOLO_MODEL=models/yolo/yolo11n.pt
JARVIS_YOLO_CONFIDENCE=0.35
JARVIS_PRESENCE_MONITOR_ENABLED=false
JARVIS_PRESENCE_INTERVAL_SECONDS=10
JARVIS_SPEAKER_MODEL=models/speaker/wespeaker.onnx
JARVIS_SPEAKER_SIMILARITY_THRESHOLD=0.65
JARVIS_SPEAKER_SAMPLE_SECONDS=5
# Email is off until network access and every TLS account field are explicitly set.
# Gmail OAuth is preferred. Download an OAuth Desktop client JSON from Google Cloud,
# save it at the client path, then run `jarvis-google-auth` once.
JARVIS_GMAIL_OAUTH_CLIENT_FILE=data/google-oauth-client.json
JARVIS_GMAIL_OAUTH_TOKEN_FILE=data/google-oauth-token.json
JARVIS_EMAIL_ADDRESS=
JARVIS_EMAIL_USERNAME=
JARVIS_EMAIL_PASSWORD=
JARVIS_SMTP_HOST=
JARVIS_SMTP_PORT=465
JARVIS_IMAP_HOST=
JARVIS_IMAP_PORT=993
JARVIS_EMAIL_TIMEOUT_SECONDS=20
